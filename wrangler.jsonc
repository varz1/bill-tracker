{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bill-tracker",
  "compatibility_date": "2026-10-24",
  "main": "./src/worker/index.ts",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // Static assets come from the Vite client build. API paths go to the Worker
  // first; everything else falls back to the SPA.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The one switch between a public demo and your own deployment. "true": the page shows a demo note, Settings are
  // locked, calendar links are capped and expire after a day. "false": none of that. The page reads it from
  // GET /api/config, and the rules live in src/worker/lib/demo.ts.
  "vars": { "DEMO": "true" },
  // Calendar sync: every 15 minutes the Worker syncs the calendars that are due (src/worker/lib/calendarSync.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // No namespace id on purpose: `wrangler deploy` provisions it automatically.
  "kv_namespaces": [{ "binding": "BILL_DATA" }]
}
